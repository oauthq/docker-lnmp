# Docker Hub namespace, e.g. yourhub -> yourhub/nginx:stable
IMAGE_NAMESPACE=yourhub

# Nginx versions to build/push (each must have a matching directory)
NGINX_VERSIONS="stable"

# Base image tag for nginx:${NGINX_BASE_TAG}
NGINX_BASE_TAG=stable-alpine

# Container timezone
TZ=Asia/Shanghai

# Alpine apk mirror host, leave empty to use the official one
ALPINE_MIRROR=mirrors.ustc.edu.cn

# Buildx platforms, e.g. "linux/amd64" or "linux/amd64,linux/arm64".
# A single platform can be loaded locally with `build`; multiple platforms
# must use `push` because the classic Docker image store cannot load them.
PLATFORMS=""
