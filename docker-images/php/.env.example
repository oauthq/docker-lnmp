# Docker Hub namespace, e.g. oauthq -> oauthq/php:8.5
IMAGE_NAMESPACE=oauthq

# PHP versions to build/push with the shared Dockerfile.
# Each version keeps its own conf.d/ and extensions/ directory.
# build.sh pins 7.4 to 7.4.33-fpm-alpine and uses <version>-fpm-alpine for 8.x.
PHP_VERSIONS="8.2 8.3 8.4 8.5"

# Composer version for the builder stage (minor pin; patch updates follow)
COMPOSER_VERSION=2.8

# Extensions to install via install-php-extensions (space separated).
# Applied to all versions; leave empty to use each version's
# extensions/install.sh default list.
PHP_EXTENSIONS="bcmath intl gd gettext mysqli mbstring curl opcache pcntl pdo_mysql redis zip"

# Container timezone
TZ=Asia/Shanghai

# Alpine apk mirror host, leave empty to use the official one
ALPINE_MIRROR=mirrors.ustc.edu.cn

# Buildx platforms, e.g. "linux/amd64" or "linux/amd64,linux/arm64".
# A single platform can be loaded locally with `build`; multiple platforms
# must use `push` because the classic Docker image store cannot load them.
PLATFORMS=""
